{
  "name": "disslxt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --if-present --filter '!@disslxt/e2e' test",
    "e2e": "pnpm --filter @disslxt/e2e test",
    "e2e:docker": "pnpm --filter @disslxt/e2e test:docker",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --if-present build",
    "db:migrate": "pnpm --filter @disslxt/backend db:migrate",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
