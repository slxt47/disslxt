# Copy to .env and adjust. Never commit .env.
# All values below are safe local-dev dummies (no real secrets).

# --- Backend (local dev) ---
# Local DB role chat/chat is created by scripts/setup-local-db.sh (local-only dev password).
DATABASE_URL=postgres://chat:chat@localhost:5432/chat_mvp_dev
TEST_DATABASE_URL=postgres://chat:chat@localhost:5432/chat_mvp_test
E2E_DATABASE_URL=postgres://chat:chat@localhost:5432/chat_mvp_e2e
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
# Set to true when served over HTTPS (docker compose sets this automatically).
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Comma-separated list of extra allowed origins (same-origin is always allowed).
ALLOWED_ORIGINS=http://localhost:5173
# Set to true when running behind a reverse proxy (Caddy).
TRUST_PROXY=false
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_MESSAGE_MAX=20
RATE_LIMIT_MESSAGE_WINDOW_MS=10000

# --- docker compose ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chat_mvp
# Address the app is opened under (hostname or public IP, e.g. 46.225.187.29); Caddy only serves
# a certificate for this address. Use HTTPS_PORT=443 / HTTP_PORT=80 for the standard ports.
SITE_ADDRESS=localhost
HTTPS_PORT=8443
HTTP_PORT=8080
