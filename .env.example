# Copy to .env and adjust. Never commit .env.
# All values below are safe local-dev dummies (no real secrets).

# --- Backend (local dev) ---
# Local DB role chat/chat is created by scripts/setup-local-db.sh (local-only dev password).
DATABASE_URL=postgres://chat:chat@localhost:5432/disslxt_dev
TEST_DATABASE_URL=postgres://chat:chat@localhost:5432/disslxt_test
E2E_DATABASE_URL=postgres://chat:chat@localhost:5432/disslxt_e2e
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
NODE_ENV=development
# Set to true when served over HTTPS (docker compose sets this automatically).
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Comma-separated list of extra allowed origins (same-origin is always allowed).
ALLOWED_ORIGINS=http://localhost:5173
# Set to true when running behind a reverse proxy (Caddy).
TRUST_PROXY=false
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_MESSAGE_MAX=20
RATE_LIMIT_MESSAGE_WINDOW_MS=10000
# Sign-up / resend mails per IP and window.
RATE_LIMIT_MAIL_MAX=5
RATE_LIMIT_MAIL_WINDOW_MS=900000

# --- E-Mail ---
# Local dev: MAIL_TRANSPORT=log keeps mails in memory; read them at /api/dev/mails.
# Production (docker compose) always uses smtp and refuses to start without the SMTP_* values.
MAIL_TRANSPORT=log
# iCloud+: smtp.mail.me.com, port 587 (STARTTLS, SMTP_SECURE=false).
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_SECURE=false
# Your Apple ID mail address (the primary iCloud address, also when sending from a custom domain).
SMTP_USER=
# App-specific password from account.apple.com → Sign-In and Security. Never your Apple ID password.
SMTP_PASS=
# Must be an address of your iCloud account (or a custom-domain address set up in iCloud+).
MAIL_FROM="disslxt <noreply@slxt.org>"
EMAIL_VERIFICATION_TTL_HOURS=24
MAIL_MAX_PER_ADDRESS_PER_HOUR=3

# --- docker compose ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=disslxt
# Public HTTPS address of the app (Cloudflare Tunnel hostname, no trailing slash). Used as the only
# allowed origin and, later, for links in e-mails and as the Web Push contact.
PUBLIC_URL=https://disslxt.slxt.org
# Local port Caddy listens on (127.0.0.1 only); point the tunnel's service URL at
# http://localhost:<HTTP_PORT>.
HTTP_PORT=8091

# --- Web Push (notifications) ---
# Generate once with: pnpm vapid:generate >> .env
# Without keys the app runs, but notifications are switched off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach you at (mailto: or https:). Default: PUBLIC_URL.
VAPID_SUBJECT=
