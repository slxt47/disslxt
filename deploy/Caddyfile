# Chat-MVP reverse proxy: HTTPS via Caddy's local CA (`tls internal`), static SPA, /api + /ws → backend.
# SITE_ADDRESS may be a hostname or a bare IP (e.g. 46.225.187.29); HTTPS_PORT is the host port
# mapped to :443, used for the HTTP → HTTPS redirect.
{
	# Browsers and curl send no SNI when connecting to an IP address; without a default SNI Caddy
	# finds no certificate and aborts the handshake ("tlsv1 alert internal error").
	default_sni {$SITE_ADDRESS:localhost}
	# Caddy's own redirect would point at port 443 inside the container; the http:// block below
	# redirects to the published HTTPS port instead.
	auto_https disable_redirects
}

http:// {
	redir https://{$SITE_ADDRESS:localhost}:{$HTTPS_PORT:8443}{uri} permanent
}

{$SITE_ADDRESS:localhost} {
	tls internal
	encode zstd gzip

	# Security headers for everything served from here (the API adds its own helmet headers too).
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle /ws {
		reverse_proxy backend:3000
	}

	handle {
		# CSP3 'self' already covers same-origin wss:// in current browsers; wss://{hostport} is
		# listed explicitly for older ones.
		header Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{hostport}; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
