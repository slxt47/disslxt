# disslxt reverse proxy behind a Cloudflare Tunnel: Cloudflare terminates HTTPS, cloudflared on
# the host forwards to http://localhost:${HTTP_PORT}, which docker compose binds to 127.0.0.1 only.
# Caddy serves the static SPA and forwards /api + /ws to the backend.
{
	# Plain HTTP only; TLS is Cloudflare's job.
	auto_https off

	servers {
		# Requests arrive from cloudflared via the Docker bridge (a private address), with the real
		# client appended to X-Forwarded-For by Cloudflare's edge. Strict mode reads it right to
		# left, so entries a client puts in front of it are ignored. The port itself is loopback
		# only, so nobody can reach Caddy without going through the tunnel.
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	# Security headers for everything served from here (the API adds its own helmet headers too).
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}

	# The backend trusts X-Forwarded-For (TRUST_PROXY=true). Overwrite it with the single resolved
	# client address so a client-supplied X-Forwarded-For can never reach the rate limiter.
	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /ws {
		reverse_proxy backend:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		# CSP3 'self' already covers same-origin wss:// in current browsers; wss://{host} is
		# listed explicitly for older ones.
		header Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{host}; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
